<Project Sdk="Microsoft.NET.Sdk">
  <!--
    多版本編譯：dotnet build -c Release -p:RevitVersion=2022..2027
    或跑 build-all.ps1 一次編六個版本。
    Revit API 由 NuGet（Nice3point.Revit.Api.*）提供，不需要在本機安裝該版 Revit。
      2022–2024 → .NET Framework 4.8
      2025–2026 → .NET 8
      2027      → .NET 10（需 .NET 10 SDK）
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <BaseOutputPath>bin\Revit$(RevitVersion)\</BaseOutputPath>

    <TargetFramework>net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>
    <EnableDynamicLoading Condition="'$(RevitVersion)' &gt;= '2025'">true</EnableDynamicLoading>

    <AssemblyName>RevitMcpAddin</AssemblyName>
    <RootNamespace>RevitMcpAddin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 14：用 extension 屬性補齊各版 ElementId API 差異（Compat/ElementIdCompat.cs） -->
    <LangVersion>14</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Version>1.4.0</Version>
    <Authors>Rita (Rirychh)</Authors>
    <Copyright>© 2026 Rita (Rirychh)</Copyright>
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>

    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2023'">$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2024'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2025'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2026'">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2027'">$(DefineConstants);REVIT2027_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Security" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <!--
    Newtonsoft.Json 要與 Revit 自帶的版本相容，執行時一律用 Revit 已載入的那份（安裝包只放 RevitMcpAddin.dll）。
    Revit 2022 自帶 11.0.2；2023 起自帶 13.x。
  -->
  <ItemGroup Condition="'$(RevitVersion)' == '2022'">
    <PackageReference Include="Newtonsoft.Json" Version="11.0.2" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' != '2022'">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- 工具清單內嵌進 DLL，由 Ai/RevitTools.cs 讀取 -->
  <ItemGroup>
    <EmbeddedResource Include="tools-manifest.json" LogicalName="RevitMcpAddin.tools-manifest.json" />
  </ItemGroup>

  <!-- 安裝包、授權工具資料夾不參與編譯（v1.3.0 起取消授權機制，Licensing 保留原始碼但不編譯）-->
  <ItemGroup>
    <Compile Remove="share-package\**;installer\**;license-tool\**;Licensing\**;bin\**;obj\**" />
  </ItemGroup>

  <!-- 把同一份 manifest 同步到 TS MCP server repo 根目錄 -->
  <PropertyGroup>
    <RevitMcpTsRepo Condition="'$(RevitMcpTsRepo)' == ''">$(MSBuildProjectDirectory)\..\revit-mcp\</RevitMcpTsRepo>
  </PropertyGroup>
  <Target Name="SyncToolsManifestToTsRepo" AfterTargets="Build"
          Condition="Exists('$(RevitMcpTsRepo)package.json')">
    <Copy SourceFiles="tools-manifest.json" DestinationFolder="$(RevitMcpTsRepo)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
